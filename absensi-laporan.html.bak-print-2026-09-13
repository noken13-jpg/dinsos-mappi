</style></head><body><header class="site-header"><div class="container nav-wrap"><a class="brand" href="index.html"><img src="LOGO MAPPI.jpg" alt="Logo Pemerintah Kabupaten Mappi"><span><small>PEMERINTAH KABUPATEN MAPPI</small><strong>DINAS SOSIAL</strong></span></a><nav class="nav-pill nav-links" aria-label="Navigasi utama"><a href="index.html">Beranda</a><a href="data-pegawai.html">Data Pegawai</a><a href="layanan-sop.html">Layanan &amp; SOP</a><a class="active" href="absensi-laporan.html">Laporan Apel</a><a href="admin-internal.html" class="text-red-400"><i class="fa-solid fa-lock" aria-hidden="true"></i> Internal (Admin)</a></nav></div></header><main><section class="page-hero section"><div class="container"><p class="eyebrow">ADMINISTRASI KEPEGAWAIAN</p><h1>Absensi &amp; Laporan <span>Apel</span></h1><p>Draft laporan absensi apel harian Dinas Sosial Kabupaten Mappi.</p></div></section><section class="section upload-section"><div class="container"><div class="mb-6"><p class="eyebrow">PANEL DOKUMEN RESMI</p><h2 class="text-2xl font-bold text-white">Unggah &amp; Validasi Laporan Fisik Apel</h2><p class="mt-2 text-slate-400">Unggah dokumen pendukung untuk melengkapi rekapan. Berkas belum dikirim ke server pada mode statis ini.</p></div><div class="grid gap-5 md:grid-cols-3"><div class="attendance-card rounded-2xl p-5"><h3 class="font-semibold text-white"><i class="fa-solid fa-sun text-cyan-300 mr-2"></i>Apel Pagi</h3><label class="dropzone mt-4 flex min-h-44 cursor-pointer flex-col items-center justify-center rounded-xl p-5 text-center"><i class="fa-solid fa-file-arrow-up text-3xl text-cyan-300"></i><span class="mt-3 text-sm font-medium text-slate-200">Unggah Lembar Absen Fisik Ttd Pegawai</span><small class="mt-1 text-slate-400">PDF/JPG · Apel Pagi</small><input class="file-input hidden" type="file" accept=".pdf,.jpg,.jpeg" data-label="Pagi"></label><p class="file-status mt-3 text-xs text-cyan-200">Belum ada file dipilih.</p></div><div class="attendance-card rounded-2xl p-5"><h3 class="font-semibold text-white"><i class="fa-solid fa-cloud-sun text-blue-300 mr-2"></i>Apel Sore</h3><label class="dropzone mt-4 flex min-h-44 cursor-pointer flex-col items-center justify-center rounded-xl p-5 text-center"><i class="fa-solid fa-file-arrow-up text-3xl text-blue-300"></i><span class="mt-3 text-sm font-medium text-slate-200">Unggah Lembar Absen Fisik Ttd Pegawai</span><small class="mt-1 text-slate-400">PDF/JPG · Apel Sore</small><input class="file-input hidden" type="file" accept=".pdf,.jpg,.jpeg" data-label="Sore"></label><p class="file-status mt-3 text-xs text-blue-200">Belum ada file dipilih.</p></div><div class="attendance-card rounded-2xl p-5"><h3 class="font-semibold text-white"><i class="fa-solid fa-camera text-violet-300 mr-2"></i>Verifikasi Wajah</h3><label class="dropzone mt-4 flex min-h-44 cursor-pointer flex-col items-center justify-center rounded-xl p-5 text-center"><i class="fa-solid fa-image text-3xl text-violet-300"></i><span class="mt-3 text-sm font-medium text-slate-200">Unggah Foto Bukti Dokumentasi Apel Bersama Pimpinan</span><small class="mt-1 text-slate-400">JPG/PNG · Foto kegiatan</small><input class="file-input hidden" type="file" accept="image/*" multiple data-label="Foto"></label><p class="file-status mt-3 text-xs text-violet-200">Belum ada file dipilih.</p></div></div><div class="gps-stamp mt-5 rounded-2xl p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-xs uppercase tracking-widest text-green-300">Stempel Lokasi Digital</p><p class="mt-2 font-semibold text-white">Lokasi Terverifikasi: Dinas Sosial Kab. Mappi</p><p class="text-sm text-slate-300">Koordinat: -6.5165° S, 139.3421° E</p></div><span class="inline-flex items-center gap-2 rounded-full bg-green-400/15 px-4 py-2 text-sm font-bold text-green-300"><i class="fa-solid fa-location-dot"></i> GPS Lock - Lokasi Valid</span></div></div></div></section><section class="section"><div class="container"><div class="attendance-card rounded-2xl p-5 md:p-7"><div class="no-print mb-6 flex flex-wrap items-center justify-between gap-3"><div><p class="eyebrow">REKAPITULASI HARIAN</p><h2 class="text-2xl font-bold text-white">Draf Laporan Apel Harian</h2><p id="employee-summary" class="mt-1 text-sm text-slate-400">Memuat data pegawai…</p></div><div class="flex flex-wrap gap-2"><button id="print-report" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500"><i class="fa-solid fa-print mr-2"></i>Cetak Laporan Apel (PDF)</button><button id="send-report" class="rounded-lg border border-cyan-400/40 bg-cyan-400/10 px-4 py-2 text-sm font-semibold text-cyan-200 hover:bg-cyan-400/20"><i class="fa-solid fa-paper-plane mr-2"></i>Kirim Laporan ke SETDA</button></div></div><div class="table-wrap"><table class="report-table w-full text-left text-sm"><thead><tr><th class="px-3 py-3">No</th><th class="px-3 py-3">Nama Pegawai</th><th class="px-3 py-3">Jabatan</th><th class="px-3 py-3">Jam Apel Pagi</th><th class="px-3 py-3">Jam Apel Sore</th><th class="px-3 py-3">Titik Koordinat GPS</th><th class="px-3 py-3">Status Kehadiran</th></tr></thead><tbody id="attendance-body"></tbody></table></div></div></div></section></main><script>
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));document.querySelectorAll('.file-input').forEach(input=>{const zone=input.closest('.dropzone'),status=zone.parentElement.querySelector('.file-status');input.addEventListener('change',()=>{status.textContent=input.files.length?`${input.files.length} file dipilih: ${Array.from(input.files).map(f=>f.name).join(', ')}`:'Belum ada file dipilih.'});['dragenter','dragover'].forEach(e=>zone.addEventListener(e,x=>{x.preventDefault();zone.classList.add('dragging')}));['dragleave','drop'].forEach(e=>zone.addEventListener(e,x=>{x.preventDefault();zone.classList.remove('dragging')}));zone.addEventListener('drop',e=>{if(e.dataTransfer.files.length){input.files=e.dataTransfer.files;input.dispatchEvent(new Event('change'))}})});fetch('pegawai.json').then(r=>r.json()).then(data=>{document.querySelector('#employee-summary').textContent=`${data.length} pegawai · draft belum ditetapkan sebagai laporan resmi`;document.querySelector('#attendance-body').innerHTML=data.map((p,i)=>`<tr><td class="px-3 py-3 text-slate-400">${i+1}</td><td class="px-3 py-3 font-medium text-white">${esc(p.nama)}</td><td class="px-3 py-3 text-slate-300">${esc(p.jabatan)}</td><td class="px-3 py-3 text-slate-400">—</td><td class="px-3 py-3 text-slate-400">—</td><td class="px-3 py-3 text-slate-400">-6.5165° S, 139.3421° E</td><td class="px-3 py-3"><select class="attendance-status rounded-md border border-slate-700/70 bg-slate-900/70 px-2 py-1 text-xs font-semibold text-amber-300 outline-none focus:border-cyan-400" aria-label="Status kehadiran ${esc(p.nama)}"><option value="Hadir" class="bg-emerald-500/20 text-emerald-300">Hadir</option><option value="Sakit" class="bg-amber-500/20 text-amber-300">Sakit</option><option value="Izin" class="bg-blue-500/20 text-blue-300">Izin</option><option value="Alpa" class="bg-red-500/20 text-red-300">Alpa</option></select></td></tr>`).join('')}).catch(()=>{document.querySelector('#employee-summary').textContent='Data pegawai tidak dapat dimuat.'});document.addEventListener('change',event=>{const select=event.target.closest('.attendance-status');if(!select)return;select.classList.remove('text-emerald-300','text-amber-300','text-blue-300','text-red-300');const colors={Hadir:'text-emerald-300',Sakit:'text-amber-300',Izin:'text-blue-300',Alpa:'text-red-300'};select.classList.add(colors[select.value]);});document.querySelector('#print-report').addEventListener('click',()=>window.print());document.querySelector('#send-report').addEventListener('click',()=>alert('Laporan masih berupa draf. Pengiriman ke SETDA memerlukan integrasi resmi dan autentikasi server.'));
</script></body></html>
